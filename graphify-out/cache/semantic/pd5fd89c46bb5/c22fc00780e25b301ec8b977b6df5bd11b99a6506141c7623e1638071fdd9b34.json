{"nodes": [{"id": "apps_mobile_assets_android_icon_monochrome_icon", "label": "Android Monochrome App Icon (Finance Buddy)", "file_type": "image", "source_file": "apps/mobile/assets/android-icon-monochrome.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_android_icon_monochrome_chevron_mark", "label": "Upward Chevron Brand Mark", "file_type": "concept", "source_file": "apps/mobile/assets/android-icon-monochrome.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_android_icon_monochrome_material_you_themed_icon_layer", "label": "Material You Themed Icon Monochrome Layer", "file_type": "rationale", "rationale": "Android 13+ themed icons require a separate single-color (monochrome) layer that the OS recolors from the user's wallpaper palette. The artwork is therefore drawn as a flat neutral-gray silhouette on a transparent/white field with no gradients, strokes of varying color, or text, so that any tint the system applies remains legible. Generous padding around the glyph reserves room for the adaptive-icon safe zone and circular/squircle masking.", "source_file": "apps/mobile/assets/android-icon-monochrome.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_mobile_assets_android_icon_monochrome_upward_growth_motif", "label": "Upward Growth / Rising Trend Visual Motif", "file_type": "concept", "rationale": "The mark reads simultaneously as a caret/arrowhead and as the rising leg of a line chart, which lets a single glyph signal financial growth and forward progress without any literal currency symbolism \u2014 appropriate for a personal-finance companion app.", "source_file": "apps/mobile/assets/android-icon-monochrome.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {